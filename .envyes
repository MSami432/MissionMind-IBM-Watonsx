WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Optional – defaults to us-south
WATSONX_REGION=us-south

# Optional – defaults to 3001
PORT=3001

# Optional – Vite dev-server origin for CORS
ALLOWED_ORIGIN=http://localhost:5173
